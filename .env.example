# このファイルをコピーして .env を作る: cp .env.example .env
# .env はコミットしない（.gitignore で除外済み）
# セキュリティのため、パスワード（MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD）は必ず変更すること。
# 変更は最初の docker compose up より前に行う（起動後に変えても DB には反映されない）
# パスワードに $ は使わない（docker compose とホストのコマンドで値の読み方が違い、接続できなくなる）

# 動かす環境（development / production）。既定は production。
# 開発用の操作（make seed でのテストユーザーの作成）は development のときだけ実行できる
APP_ENV=development

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=helpdesk
MYSQL_USER=helpdesk
MYSQL_PASSWORD=change-me

# ホストから直接つなぐとき（alembic など）の接続先。
# docker compose 内の be コンテナは compose 側で db:3306 に上書きする
MYSQL_HOST=localhost
MYSQL_PORT=3307

# テスト用 DB（db-test コンテナ）。ユーザーとパスワードは上と共通
TEST_MYSQL_DATABASE=helpdesk_test
TEST_MYSQL_HOST=localhost
TEST_MYSQL_PORT=3308

# 画面（FE）の URL。この URL からだけ、ログインの Cookie 付きで API を呼べる（CORS）。
# JSON の形で、全体を ' ' で囲んで書く（複数あるときは '["https://a.example.com", "https://b.example.com"]'）。
# 本番では、本番の画面の URL に変更すること（変更しないと、画面からログインできない）
CORS_ORIGINS='["http://localhost:5173"]'

# ログイン用トークン（JWT）の署名に使う秘密の値。32 文字以上が必須
# この見本の値のままだと BE は起動しない。自分で作った値に変更すること（作り方の例: openssl rand -hex 32）
JWT_SECRET_KEY=change-me

# ログインの Cookie を HTTPS の通信でだけ送るか（既定は true）。
# 開発環境は http://localhost のため false にする。本番（HTTPS）では書かない（または true にする）
COOKIE_SECURE=false

# API の説明画面（http://localhost:8000/docs）を表示するか（既定は false）。
# 開発環境では true にする。本番では書かない（API の一覧を外部に見せないため）
ENABLE_API_DOCS=true
