{
    // ===== Frontend（helpdesk-fe）: ESLint / Prettier =====
    // ESLint の設定ファイル（helpdesk-fe/eslint.config.js）を見つけられるように、作業フォルダを指定する
    "eslint.workingDirectories": [{ "directory": "./helpdesk-fe", "changeProcessCWD": true }],
    // Prettier は設定ファイル（.prettierrc.json）があるフォルダでだけ動かす
    "prettier.requireConfig": true,

    // 保存時に Prettier で整形し、ESLint で自動修正できる指摘を直す
    // formatOnSaveMode: "file" … 個人設定で「変更した行だけ整形」になっていても、ファイル全体を整形する
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file"
    },

    // ===== Backend（helpdesk-be）: Ruff =====
    // Python の仮想環境として helpdesk-be/.venv を使う（README の手順で作成したもの）
    "python.defaultInterpreterPath": "${workspaceFolder}/helpdesk-be/.venv/bin/python",
    // 拡張機能に同梱の Ruff ではなく、仮想環境の Ruff（poetry.lock で固定したバージョン）を使う
    "ruff.importStrategy": "fromEnvironment",

    // 保存時に Ruff で整形し、自動で直せる指摘と import の並び順を直す
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    }
}
